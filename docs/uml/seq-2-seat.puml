@startuml seq-2-seat
!include seq-style.puml
mainframe sd Serve the Critic — 2 of 7: turn 10, the Host seats C4
autonumber 17 "<b>0"

actor Manager
participant "input :\nCommandInput" as IN <<boundary>>
participant "game :\nGameController" as GC <<control>>
participant "host :\nHost" as H <<entity>>
participant "seatTask :\nSeatTask" as ST <<entity>>
participant "restaurant :\nRestaurant" as R <<entity>>
participant "c4 :\nCriticCustomer" as C <<entity>>

group Host acts first: seat C4
  GC -> IN : chooseTask(host, allowed, restaurant)
  Manager --> IN : seat C4 T2
  IN -> ST : <<create>>
  GC -> H : perform(seatTask, restaurant, 10)
  H -> ST : perform(restaurant, 10)
  ST -> ST : check(restaurant, 10)
  ST -> ST : apply(restaurant, 10)
  ST -> R : seat(c4, t2)
  R -> C : sitAt(t2)
end
@enduml
